    "id": "dirty_title_is_not_overwritten",
    "kind": "merge",
    "current": {
      "sourceUrl": "https://example.com/a",
      "title": "My title",
      "imageUrl": ""
    },
    "dirty": ["title"],
    "incoming": {
      "title": "Automatic title",
      "imageUrl": "https://example.com/image.jpg"
    },
    "expected": {
