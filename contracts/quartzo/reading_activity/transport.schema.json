{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quartzo:reading-transport:1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "scope": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "requestId": {
      "type": "string",
      "pattern": "^qrtr_[a-f0-9]{32}$(?![\\s\\S])"
    },
    "batchId": {
      "type": "string",
      "pattern": "^qrtb_[a-f0-9]{64}$(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}(?:[0-9]{3})?Z$(?![\\s\\S])"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "binding_id",
        "vault_scope",
        "device_id",
        "source_epoch",
        "request_id",
        "issued_at_utc",
        "expires_at_utc",
        "batch_id",
        "event_lines"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "binding_id": {
          "$ref": "#/$defs/scope"
        },
        "vault_scope": {
          "$ref": "#/$defs/scope"
        },
        "device_id": {
          "$ref": "#/$defs/scope"
        },
        "source_epoch": {
          "$ref": "#/$defs/scope"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "issued_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "batch_id": {
          "$ref": "#/$defs/batchId"
        },
        "event_lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\r\\n]+$(?![\\s\\S])"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "binding_id",
        "vault_scope",
        "device_id",
        "source_epoch",
        "request_id",
        "batch_id",
        "results"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "binding_id": {
          "$ref": "#/$defs/scope"
        },
        "vault_scope": {
          "$ref": "#/$defs/scope"
        },
        "device_id": {
          "$ref": "#/$defs/scope"
        },
        "source_epoch": {
          "$ref": "#/$defs/scope"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "batch_id": {
          "$ref": "#/$defs/batchId"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "line_digest",
        "event_id",
        "native_digest",
        "outcome",
        "canonical_commit"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "line_digest": {
          "$ref": "#/$defs/digest"
        },
        "event_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^qre_[a-f0-9]{64}$(?![\\s\\S])"
            }
          ]
        },
        "native_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "outcome": {
          "enum": [
            "committed",
            "duplicate",
            "staged",
            "retryable",
            "auth_required",
            "unsupported_version",
            "conflict",
            "review",
            "fatal_corruption"
          ]
        },
        "canonical_commit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/scope"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "committed",
              "duplicate"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "event_id": {
            "type": "string"
          },
          "native_digest": {
            "type": "string"
          },
          "canonical_commit": {
            "$ref": "#/$defs/scope"
          }
        }
      },
      "else": {
        "properties": {
          "canonical_commit": {
            "type": "null"
          }
        }
      }
    }
  }
}
