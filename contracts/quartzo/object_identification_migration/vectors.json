{
  "version": "1.0.0",
  "description": "Pure Object Identification marker migration vectors. Adapters own vault scanning, preflight, writes, moves, shared-settings persistence and reindex.",
  "cases": [
    {
      "name": "property_to_property",
      "objectType": "task",
      "oldSignature": {"objectType": "task", "markerType": "property", "markerValue": "type: task"},
      "newSignature": {"objectType": "task", "markerType": "property", "markerValue": "kind: task"},
      "candidate": {
        "path": "app/task.md",
        "frontmatter": {"id": "t1", "type": "task", "title": "Task", "future": {"keep": true}},
        "body": "Body"
      },
      "expected": {
        "eligible": true,
        "path": "app/task.md",
        "frontmatter": {"id": "t1", "title": "Task", "future": {"keep": true}, "kind": "task"},
        "body": "Body",
        "removeOldMarker": true,
        "applyNewMarker": true,
        "move": false
      }
    },
    {
      "name": "property_to_tag",
      "objectType": "task",
      "oldSignature": {"objectType": "task", "markerType": "property", "markerValue": "type: task"},
      "newSignature": {"objectType": "task", "markerType": "tag", "markerValue": "#task"},
      "candidate": {
        "path": "app/task.md",
        "frontmatter": {"id": "t1", "type": "task", "title": "Task"},
        "body": "Body"
      },
      "expected": {
        "eligible": true,
        "path": "app/task.md",
        "frontmatter": {"id": "t1", "title": "Task"},
        "body": "Body\n\n#task",
        "removeOldMarker": true,
        "applyNewMarker": true,
        "move": false
      }
    },
    {
      "name": "tag_to_property_preserves_unrelated_tags",
      "objectType": "task",
      "oldSignature": {"objectType": "task", "markerType": "tag", "markerValue": "#task"},
      "newSignature": {"objectType": "task", "markerType": "property", "markerValue": "type: task"},
      "candidate": {
        "path": "app/task.md",
        "frontmatter": {"id": "t1", "title": "Task", "tags": ["task", "deep-work"]},
        "body": "Body #task #deep-work"
      },
      "expected": {
        "eligible": true,
        "path": "app/task.md",
        "frontmatter": {"id": "t1", "title": "Task", "tags": ["deep-work"], "type": "task"},
        "body": "Body  #deep-work",
        "removeOldMarker": true,
        "applyNewMarker": true,
        "move": false
      }
    },
    {
      "name": "tag_to_tag",
